---
import { github } from "../data/projects";
---

<header class="border-b hairline">
  <div class="mx-auto flex max-w-6xl items-baseline justify-between gap-6 px-5 py-5 sm:px-8 lg:px-12">
    <a
      href="/"
      class="font-display text-lg font-semibold tracking-tight text-ink no-underline sm:text-xl"
    >
      Carson Richter
    </a>
    <a
      href={github}
      class="text-sm tracking-wide text-ink underline decoration-rust/40 underline-offset-4 transition-colors hover:text-rust hover:decoration-rust"
    >
      GitHub
    </a>
  </div>
</header>
