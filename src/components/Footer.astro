---
import { github } from "../data/projects";
---

<footer class="mt-auto border-t hairline">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-5 py-8 sm:flex-row sm:items-baseline sm:justify-between sm:px-8 lg:px-12">
    <p class="font-display text-sm tracking-wide text-ink/70">
      Carson Richter
    </p>
    <a
      href={github}
      class="text-sm tracking-wide text-ink underline decoration-rust/40 underline-offset-4 transition-colors hover:text-rust hover:decoration-rust"
    >
      GitHub
    </a>
  </div>
</footer>
